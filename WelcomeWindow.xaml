<Window x:Class="n1ssan_launcher.WelcomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="n1ssan" Loaded="WelcomeWindow_Loaded" Width="480" Height="560" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
<Border CornerRadius="22" BorderBrush="#35FFFFFF" BorderThickness="1" ClipToBounds="True"><Grid Background="#050806">
<Rectangle x:Name="AmbientBackground"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#050806" Offset="0"/><GradientStop Color="#102719" Offset="0.48"/><GradientStop Color="#07100A" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
