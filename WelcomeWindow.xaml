<Window x:Class="n1ssan_launcher.WelcomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CS2 INTEGRATION" Loaded="WelcomeWindow_Loaded" Width="290" Height="480" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize" AllowsTransparency="True" Background="Transparent" SourceInitialized="Window_SourceInitialized">
    <Border CornerRadius="27" BorderBrush="#66FFFFFF" Background="#E8101712" ClipToBounds="True">
        <Grid Background="#E80B100D" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="455.583"/>
                <RowDefinition Height="22.417"/>
            </Grid.RowDefinitions>
            <Rectangle x:Name="AmbientBackground" Grid.RowSpan="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#050806" Offset="0"/>
                        <GradientStop Color="#102719" Offset="0.48"/>
                        <GradientStop Color="#07100A" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse x:Name="AuroraGlow" Width="430" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-180,0,0" Fill="#7025D366" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TranslateTransform/>
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                    <BlurEffect Radius="95"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="330" Height="330" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-150" Fill="#2525D366" Grid.RowSpan="2">
                <Ellipse.Effect>
                    <BlurEffect Radius="90"/>
                </Ellipse.Effect>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,252,0,0">
                <TextBlock Text="Initializing..." FontFamily="Barlow" FontSize="15" FontWeight="Medium" Foreground="#E8F0EA" HorizontalAlignment="Center"/>
                <Border Width="42" Height="2" Background="#252D28" CornerRadius="1" Margin="0,17,0,0" HorizontalAlignment="Center">
                    <Border x:Name="InitializingBar" Width="0" Background="#25D366" CornerRadius="1" HorizontalAlignment="Left"/>
                </Border>
            </StackPanel>
            <TextBlock Text="BY CXNCER" FontFamily="Barlow" FontSize="7" FontWeight="Medium" Foreground="#E8F0EA" Margin="104,454,105,15" TextAlignment="Center" Grid.RowSpan="2"/>
            <Image x:Name="WelcomeLogo" Stretch="Uniform" Margin="104,126,106,252"/>
        </Grid>
    </Border>
</Window>