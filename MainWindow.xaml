<Window x:Class="n1ssan_launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CS2 INTEGRATION" Width="380" Height="520" MinWidth="380" MinHeight="520" MaxWidth="380" MaxHeight="520" WindowStartupLocation="CenterScreen" Background="#01000000" SourceInitialized="Window_SourceInitialized" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI" ResizeMode="CanMinimize" WindowStyle="None" SizeToContent="WidthAndHeight">
<Window.Resources>
<Style x:Key="GlassOptionButton" TargetType="Button"><Setter Property="Background" Value="#251C241F"/><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#4030523B"/><Setter TargetName="Card" Property="BorderBrush" Value="#9925D366"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="#5530523B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Border CornerRadius="25" BorderBrush="#55FFFFFF" BorderThickness="1" Background="#35101814" ClipToBounds="True"><Grid ClipToBounds="True">
<Grid.Background><SolidColorBrush Color="#170B100D"/></Grid.Background>
<Ellipse x:Name="AuroraGlow" Width="340" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-175,0,0" Fill="#3525D366" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform><Ellipse.Effect><BlurEffect Radius="85"/></Ellipse.Effect></Ellipse>
<Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-145" Fill="#1725D366"><Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect></Ellipse>
<Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="25,0,18,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
<TextBlock Text="CS2 INTEGRATION" FontSize="11" FontWeight="Bold" Foreground="#EAF2EC" VerticalAlignment="Center"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="—" Style="{StaticResource WindowControlButton}" Click="Minimize_Click"/><Button Content="×" Style="{StaticResource WindowControlButton}" FontSize="19" Click="Close_Click"/></StackPanel>
</Grid>
<Grid x:Name="DashboardView" Grid.Row="1" Margin="28,8,28,8"><StackPanel VerticalAlignment="Center">
<StackPanel HorizontalAlignment="Center" Margin="0,0,0,16"><Image x:Name="N1ssanLogo" Width="68" Height="68" Stretch="Uniform" Margin="0,0,0,13"/><TextBlock Text="SYSTEM DETECTION" FontSize="10" FontWeight="Bold" Foreground="#B7C5BB" HorizontalAlignment="Center"/></StackPanel>
<Border Background="#24FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#243D3029" VerticalAlignment="Center"><Image x:Name="Cs2Icon" Stretch="Uniform" Source="/cs2-white.png" Margin="4,3,4,3"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="Counter-Strike 2" FontSize="12" FontWeight="SemiBold" Foreground="#F0F3F0"/><TextBlock x:Name="Cs2StatusText" Text="Waiting for game" FontSize="9" Foreground="#929D95" Margin="0,3,0,0"/></StackPanel><Ellipse x:Name="Cs2StatusCircle" Grid.Column="2" Width="8" Height="8" Stroke="#929D95" StrokeThickness="1.3" Fill="#33171819" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Border>
<Border Background="#24FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#243D3029" VerticalAlignment="Center"><Image x:Name="BridgeIcon" Stretch="Uniform" Source="/connection-white.png" Margin="9,7,9,7"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="n1ssan Bridge" FontSize="12" FontWeight="SemiBold" Foreground="#F0F3F0"/><TextBlock x:Name="BridgeStatusText" Text="Waiting for connection" FontSize="9" Foreground="#929D95" Margin="0,3,0,0"/></StackPanel><Ellipse x:Name="BridgeStatusCircle" Grid.Column="2" Width="8" Height="8" Stroke="#929D95" StrokeThickness="1.3" Fill="#33171819" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Border>
<Border Background="#24FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#243D3029" VerticalAlignment="Center"><Image x:Name="DllIcon" Margin="9,9,9,9" Stretch="Uniform" Source="/dll-white.png"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="n1ssan DLL" FontSize="12" FontWeight="SemiBold" Foreground="#F0F3F0"/><TextBlock x:Name="DllStatusText" Text="Waiting for initialization" FontSize="9" Foreground="#929D95" Margin="0,3,0,0"/></StackPanel><Ellipse x:Name="DllStatusCircle" Grid.Column="2" Width="8" Height="8" Stroke="#929D95" StrokeThickness="1.3" Fill="#33171819" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Border>
<TextBlock x:Name="SystemReadinessText" Text="Waiting for Counter-Strike 2." FontSize="9" Foreground="#8D9991" TextAlignment="Center" TextWrapping="Wrap" Margin="4,17,4,0"/>
</StackPanel></Grid>
<Grid x:Name="DestinationView" Grid.Row="1" Margin="28,12,28,12" Visibility="Collapsed"><StackPanel VerticalAlignment="Center">
<TextBlock Text="CHOOSE YOUR MODE" FontSize="9" FontWeight="Bold" Foreground="#8B9A8F" HorizontalAlignment="Center"/>
<TextBlock Text="Where to?" FontSize="22" FontWeight="SemiBold" Foreground="#F4F7F4" HorizontalAlignment="Center" Margin="0,8,0,0"/>
<TextBlock Text="Select your n1ssan experience." FontSize="10" Foreground="#8D9991" HorizontalAlignment="Center" Margin="0,5,0,20"/>
<Button Click="Armory_Click" Style="{StaticResource GlassOptionButton}" Margin="0,0,0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Viewbox Width="24" Height="24" VerticalAlignment="Center"><Path Fill="#25D366" Data="M3,7 L12,3 L21,7 L12,11 Z M3,10 L12,14 L21,10 M3,14 L12,18 L21,14 M3,18 L12,22 L21,18"/></Viewbox><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="ARMORY" FontSize="12" FontWeight="Bold" Foreground="#F3F6F3"/><TextBlock Text="Manage inventory and cosmetic profiles." FontSize="9" Foreground="#98A39B" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="→" FontSize="18" Foreground="#25D366" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Button>
<Button Click="Loadout_Click" Style="{StaticResource GlassOptionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Viewbox Width="24" Height="24" VerticalAlignment="Center"><Path Fill="#25D366" Data="M4,5 L20,5 L20,19 L4,19 Z M8,9 L16,9 M8,12 L16,12 M8,15 L13,15"/></Viewbox><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="LOADOUT" FontSize="12" FontWeight="Bold" Foreground="#F3F6F3"/><TextBlock Text="Configure your equipped weapon skins." FontSize="9" Foreground="#98A39B" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="→" FontSize="18" Foreground="#25D366" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Button>
</StackPanel></Grid>
<Grid Grid.Row="2" Margin="25,0,25,0"><TextBlock Text=" " FontSize="8" VerticalAlignment="Center"/>
<Button x:Name="DominateButton" Content="CONTINUE  →" Click="Dominate_Click" Width="132" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="False" Background="#25D366" Foreground="#07130B" FontSize="10" FontWeight="Bold" BorderThickness="0" Cursor="Hand"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ButtonBackground" Background="#25D366" CornerRadius="8" Opacity="0.38"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="True"><Setter TargetName="ButtonBackground" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="#42E77A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="#1EAA53"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#718077"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
<Button x:Name="BackToDashboardButton" Content="← BACK" Click="BackToDashboard_Click" Width="90" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#292F2B" Foreground="#DCE5DE" FontSize="9" FontWeight="Bold" BorderThickness="1" BorderBrush="#35FFFFFF" Cursor="Hand" Visibility="Collapsed"/>
</Grid>
</Grid></Grid></Border></Window>