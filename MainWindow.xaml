<Window x:Class="n1ssan_launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="n1ssan"
        Width="960"
        Height="620"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="DM Sans"
        ResizeMode="CanMinimize">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="36,0,24,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="n1ssan"
                               FontFamily="Space Grotesk"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="COUNTER-STRIKE 2 INTEGRATION"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="1,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,18,0,0">

                    <Button Content="—"
                            Style="{StaticResource WindowControlButton}"
                            Click="Minimize_Click"/>

                    <Button Content="×"
                            Style="{StaticResource WindowControlButton}"
                            FontSize="21"
                            Click="Close_Click"/>

                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="1"
                  Margin="36,18,36,18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- INTRODUCTION -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,28">

                    <TextBlock Text="SYSTEM OVERVIEW"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

                    <TextBlock Text="Your environment, at a glance."
                               FontSize="23"
                               FontWeight="SemiBold"
                               Margin="0,9,0,0"/>

                    <TextBlock Text="Monitor your game and n1ssan connection."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- STATUS CARDS -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CS2 -->
                    <Border Grid.Column="0"
                            Background="{StaticResource Cs2CardGradient}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            MinHeight="165">

                        <StackPanel>
                            <TextBlock Text="01 / GAME PROCESS"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock Text="Counter-Strike 2"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,19,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,17,0,0">

                                <Ellipse x:Name="Cs2StatusCircle"
                                         Width="9"
                                         Height="9"
                                         Stroke="{StaticResource SecondaryTextBrush}"
                                         StrokeThickness="1.5"
                                         Fill="#33171819"/>

                                <TextBlock x:Name="Cs2StatusText"
                                           Text="Waiting for game"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DATA -->
                    <Border Grid.Column="2"
                            Background="{StaticResource LoadoutCardGradient}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            MinHeight="165">

                        <StackPanel>
                            <TextBlock Text="02 / BRIDGE INITIALIZATION"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock Text="n1ssan Bridge"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,19,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,17,0,0">

                                <Ellipse x:Name="BridgeStatusCircle"
                                         Width="9"
                                         Height="9"
                                         Stroke="{StaticResource SecondaryTextBrush}"
                                         StrokeThickness="1.5"
                                         Fill="#33171819"/>

                                <TextBlock x:Name="BridgeStatusText"
                                           Text="Waiting for data"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- BRIDGE -->
                    <Border Grid.Column="4"
                            Background="{StaticResource BridgeCardGradient}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            MinHeight="165">

                        <StackPanel>
                            <TextBlock Text="03 / DLL INJECTION"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock Text="n1ssan DLL"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,19,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,17,0,0">

                                <Ellipse x:Name="DllStatusCircle"
                                         Width="9"
                                         Height="9"
                                         Stroke="{StaticResource SecondaryTextBrush}"
                                         StrokeThickness="1.5"
                                         Fill="#33171819"/>

                                <TextBlock x:Name="DllStatusText"
                                           Text="Waiting for connection"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SYSTEM INFORMATION -->
                <Border Grid.Row="2"
                        Background="#161616"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,22,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM STATUS"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"/>

                            <TextBlock x:Name="SystemReadinessText"
                                       Text="Checking system..."
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,9,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="N1SSAN / OVERDRIVE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- FOOTER -->
            <Grid Grid.Row="2"
                  Margin="36,0,36,0">

                <TextBlock Text="CXNCER  /  N1SSAN"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"/>

                <Button Content="DOMINATE  →"
                        Click="Dominate_Click"
                        Width="160"
                        Height="44"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource PrimaryTextBrush}"
                        Foreground="{StaticResource BackgroundBrush}"
                        FontSize="12"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground"
                                            Property="Background"
                                            Value="#25D366"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBackground"
                                            Property="Background"
                                            Value="#1EAA53"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
