<Window x:Class="n1ssan_launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="n1ssan" Width="480" Height="560" MinWidth="480" MinHeight="560" MaxWidth="480" MaxHeight="560" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI" ResizeMode="CanMinimize">
<Window.Resources>
<Style x:Key="GlassOptionButton" TargetType="Button"><Setter Property="Background" Value="#251C241F"/><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#4030523B"/><Setter TargetName="Card" Property="BorderBrush" Value="#9925D366"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="#5530523B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Border CornerRadius="22" BorderBrush="#45FFFFFF" BorderThickness="1" Background="#D90B100D" ClipToBounds="True"><Grid>
<Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E0121713" Offset="0"/><GradientStop Color="#E60A0D0B" Offset="0.52"/><GradientStop Color="#E6101B14" Offset="1"/></LinearGradientBrush></Grid.Background>
<Ellipse Width="340" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-175,0,0" Fill="#1E25D366"><Ellipse.Effect><BlurEffect Radius="85"/></Ellipse.Effect></Ellipse>
<Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-145" Fill="#1725D366"><Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect></Ellipse>
<Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="25,0,18,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
<StackPanel VerticalAlignment="Center"><TextBlock Text="n1ssan" FontSize="19" FontWeight="Bold" Foreground="#F4F7F4"/><TextBlock Text="DOMINATE / CS2 INTEGRATION" FontSize="8" FontWeight="SemiBold" Foreground="#829087" Margin="1,1,0,0"/></StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="—" Style="{StaticResource WindowControlButton}" Click="Minimize_Click"/><Button Content="×" Style="{StaticResource WindowControlButton}" FontSize="19" Click="Close_Click"/></StackPanel>
</Grid>
<Grid x:Name="DashboardView" Grid.Row="1" Margin="28,8,28,8"><StackPanel VerticalAlignment="Center">
<StackPanel HorizontalAlignment="Center" Margin="0,0,0,23"><TextBlock Text="SYSTEM DETECTION" FontSize="9" FontWeight="Bold" Foreground="#8B9A8F" HorizontalAlignment="Center"/><TextBlock Text="Preparing your environment" FontSize="19" FontWeight="SemiBold" Foreground="#F4F7F4" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Three checks before you enter." FontSize="10" Foreground="#8D9991" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
<Border Background="#24FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#243D3029" VerticalAlignment="Center"><Viewbox Margin="8"><Path x:Name="Cs2Icon" Fill="#9AA69D" Data="M4,9 C4,6.8 5.7,5 7.8,5 L9.5,5 L11,7 L17,7 L18.5,5 L20.2,5 C22.3,5 24,6.8 24,9 L23,17 C22.8,18.8 20.5,19.5 19.3,18.1 L16.8,15.5 L11.2,15.5 L8.7,18.1 C7.5,19.5 5.2,18.8 5,17 Z M8,9 L8,13 M6,11 L10,11"/></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="Counter-Strike 2" FontSize="12" FontWeight="SemiBold" Foreground="#F0F3F0"/><TextBlock x:Name="Cs2StatusText" Text="Waiting for game" FontSize="9" Foreground="#929D95" Margin="0,3,0,0"/></StackPanel><Ellipse x:Name="Cs2StatusCircle" Grid.Column="2" Width="8" Height="8" Stroke="#929D95" StrokeThickness="1.3" Fill="#33171819" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Border>
<Border Background="#24FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#243D3029" VerticalAlignment="Center"><Viewbox Margin="8"><Path x:Name="BridgeIcon" Fill="#9AA69D" Data="M12,3 L12,9 M5,9 L19,9 M5,9 L5,16 M12,9 L12,16 M19,9 L19,16 M2,16 L8,16 L8,21 L2,21 Z M9,16 L15,16 L15,21 L9,21 Z M16,16 L22,16 L22,21 L16,21 Z"/></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="n1ssan Bridge" FontSize="12" FontWeight="SemiBold" Foreground="#F0F3F0"/><TextBlock x:Name="BridgeStatusText" Text="Waiting for connection" FontSize="9" Foreground="#929D95" Margin="0,3,0,0"/></StackPanel><Ellipse x:Name="BridgeStatusCircle" Grid.Column="2" Width="8" Height="8" Stroke="#929D95" StrokeThickness="1.3" Fill="#33171819" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Border>
<Border Background="#24FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#243D3029" VerticalAlignment="Center"><Viewbox Margin="8"><Path x:Name="DllIcon" Fill="#9AA69D" Data="M7,3 L17,3 L17,7 L21,7 L21,17 L17,17 L17,21 L7,21 L7,17 L3,17 L3,7 L7,7 Z M9,9 L15,9 L15,15 L9,15 Z M1,9 L4,9 M1,13 L4,13 M20,9 L23,9 M20,13 L23,13"/></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="n1ssan DLL" FontSize="12" FontWeight="SemiBold" Foreground="#F0F3F0"/><TextBlock x:Name="DllStatusText" Text="Waiting for initialization" FontSize="9" Foreground="#929D95" Margin="0,3,0,0"/></StackPanel><Ellipse x:Name="DllStatusCircle" Grid.Column="2" Width="8" Height="8" Stroke="#929D95" StrokeThickness="1.3" Fill="#33171819" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Border>
<TextBlock x:Name="SystemReadinessText" Text="Waiting for Counter-Strike 2." FontSize="9" Foreground="#8D9991" TextAlignment="Center" TextWrapping="Wrap" Margin="4,17,4,0"/>
</StackPanel></Grid>
<Grid x:Name="DestinationView" Grid.Row="1" Margin="28,12,28,12" Visibility="Collapsed"><StackPanel VerticalAlignment="Center">
<TextBlock Text="CHOOSE YOUR MODE" FontSize="9" FontWeight="Bold" Foreground="#8B9A8F" HorizontalAlignment="Center"/>
<TextBlock Text="Where to?" FontSize="22" FontWeight="SemiBold" Foreground="#F4F7F4" HorizontalAlignment="Center" Margin="0,8,0,0"/>
<TextBlock Text="Select your n1ssan experience." FontSize="10" Foreground="#8D9991" HorizontalAlignment="Center" Margin="0,5,0,20"/>
<Button Click="Armory_Click" Style="{StaticResource GlassOptionButton}" Margin="0,0,0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Viewbox Width="24" Height="24" VerticalAlignment="Center"><Path Fill="#25D366" Data="M3,7 L12,3 L21,7 L12,11 Z M3,10 L12,14 L21,10 M3,14 L12,18 L21,14 M3,18 L12,22 L21,18"/></Viewbox><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="ARMORY" FontSize="12" FontWeight="Bold" Foreground="#F3F6F3"/><TextBlock Text="Manage inventory and cosmetic profiles." FontSize="9" Foreground="#98A39B" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="→" FontSize="18" Foreground="#25D366" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Button>
<Button Click="Loadout_Click" Style="{StaticResource GlassOptionButton}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Viewbox Width="24" Height="24" VerticalAlignment="Center"><Path Fill="#25D366" Data="M4,5 L20,5 L20,19 L4,19 Z M8,9 L16,9 M8,12 L16,12 M8,15 L13,15"/></Viewbox><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="LOADOUT" FontSize="12" FontWeight="Bold" Foreground="#F3F6F3"/><TextBlock Text="Configure your equipped weapon skins." FontSize="9" Foreground="#98A39B" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="→" FontSize="18" Foreground="#25D366" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid></Button>
</StackPanel></Grid>
<Grid Grid.Row="2" Margin="25,0,25,0"><TextBlock Text="N1SSAN / DOMINATE" FontSize="8" FontWeight="SemiBold" Foreground="#68766D" VerticalAlignment="Center"/>
<Button x:Name="DominateButton" Content="DOMINATE →" Click="Dominate_Click" Width="145" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="False" Background="#25D366" Foreground="#07130B" FontSize="10" FontWeight="Bold" BorderThickness="0" Cursor="Hand"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ButtonBackground" Background="#25D366" CornerRadius="8" Opacity="0.38"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="True"><Setter TargetName="ButtonBackground" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="#42E77A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBackground" Property="Background" Value="#1EAA53"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#718077"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
<Button x:Name="BackToDashboardButton" Content="← BACK" Click="BackToDashboard_Click" Width="90" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#292F2B" Foreground="#DCE5DE" FontSize="9" FontWeight="Bold" BorderThickness="1" BorderBrush="#35FFFFFF" Cursor="Hand" Visibility="Collapsed"/>
</Grid>
</Grid></Grid></Border></Window>