<Window x:Class="n1ssan_launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="n1ssan"
        Height="500"
        Width="850"
        MinHeight="450"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F0F2F0"
        FontFamily="DM Sans"
        ResizeMode="CanMinimize">

    <Border BorderBrush="#443BFF8A"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">

        <Border.Background>
            <RadialGradientBrush
                Center="0.5,0.0"
                GradientOrigin="0.5,0.0"
                RadiusX="0.9"
                RadiusY="1.0">

                <GradientStop Color="#182016" Offset="0.0"/>
                <GradientStop Color="#111511" Offset="0.32"/>
                <GradientStop Color="#0B0D0B" Offset="0.70"/>
                <GradientStop Color="#080909" Offset="1.0"/>

            </RadialGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="32,12,8,0"
                  Height="58"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="n1ssan"
                               FontFamily="Space Grotesk"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#1ED760"/>

                    <TextBlock Text="CS2 LOADOUT LAUNCHER"
                               FontSize="10"
                               Foreground="#87918A"
                               Margin="1,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">

                    <Button Content="—"
                            Width="42"
                            Height="34"
                            FontSize="17"
                            Foreground="#929790"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Minimize_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="#333333"/>
                                        <Setter Property="Foreground"
                                                Value="#F0F2F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="×"
                            Width="42"
                            Height="34"
                            FontSize="22"
                            Foreground="#929790"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="#D93645"/>
                                        <Setter Property="Foreground"
                                                Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- STATUS PANEL -->
            <Border Grid.Row="1"
                    Background="#B30C0F0D"
                    BorderBrush="#333BFF8A"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="26,24"
                    Margin="32,18,32,18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="SYSTEM STATUS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#929790"/>

                    <!-- STATUS INDICATORS -->
                    <Grid Grid.Row="1"
                          VerticalAlignment="Center"
                          Margin="0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Height="1"
                                Background="#554B514D"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Margin="95,16,95,0"
                                Panel.ZIndex="0"/>

                        <!-- CHECK 1: CS2 -->
                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    Width="190"
                                    Panel.ZIndex="1">

                            <TextBlock Text="CS2 DETECTED"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <Ellipse x:Name="Cs2StatusCircle"
                                     Width="34"
                                     Height="34"
                                     Stroke="#929790"
                                     StrokeThickness="2"
                                     Fill="#33171819"
                                     HorizontalAlignment="Center"/>

                            <TextBlock x:Name="Cs2StatusText"
                                       Text="Waiting for game"
                                       FontSize="11"
                                       Foreground="#929790"
                                       TextAlignment="Center"
                                       Margin="0,14,0,0"/>
                        </StackPanel>

                        <!-- CHECK 2: SAVED DATA -->
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Width="190"
                                    Panel.ZIndex="1">

                            <TextBlock Text="DATA AVAILABLE"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <Ellipse x:Name="DataStatusCircle"
                                     Width="34"
                                     Height="34"
                                     Stroke="#929790"
                                     StrokeThickness="2"
                                     Fill="#33171819"
                                     HorizontalAlignment="Center"/>

                            <TextBlock x:Name="DataStatusText"
                                       Text="Waiting for data"
                                       FontSize="11"
                                       Foreground="#929790"
                                       TextAlignment="Center"
                                       Margin="0,14,0,0"/>
                        </StackPanel>

                        <!-- CHECK 3: BRIDGE -->
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    Width="190"
                                    Panel.ZIndex="1">

                            <TextBlock Text="BRIDGE CONNECTED"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <Ellipse x:Name="BridgeStatusCircle"
                                     Width="34"
                                     Height="34"
                                     Stroke="#929790"
                                     StrokeThickness="2"
                                     Fill="#33171819"
                                     HorizontalAlignment="Center"/>

                            <TextBlock x:Name="BridgeStatusText"
                                       Text="Waiting for connection"
                                       FontSize="11"
                                       Foreground="#929790"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>
                        </StackPanel>

                    </Grid>


                    <TextBlock x:Name="SystemReadinessText"
                               Grid.Row="2"
                               Text="Checking system..."
                               FontSize="12"
                               Foreground="#929790"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                </Grid>
            </Border>

            <!-- FOOTER -->
            <Grid Grid.Row="2"
                  Margin="32,0,32,22">

                <TextBlock Text="CXNCER / N1SSAN"
                           Foreground="#87918A"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Button Content="DOMINATE"
                        Click="Dominate_Click"
                        Width="130"
                        Height="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1ED760"
                        Foreground="#101112"
                        FontWeight="Bold"
                        FontSize="13"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="7">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="#39F078"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background"
                                            Value="#17B94D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Grid>
    </Border>
</Window>
