<Application x:Class="n1ssan_launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="WelcomeWindow.xaml">

    <Application.Resources>
      <ResourceDictionary>

        <ResourceDictionary.MergedDictionaries>
            <!-- Shared palette: mirrors src/shared/tokens.css in the web Bridge. -->
            <ResourceDictionary Source="Theme/DesignTokens.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- Core palette (aliases of the shared tokens) -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource N1Surface0Color}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource N1Surface1Color}"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource N1Surface3Color}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource N1BorderColor}"/>

        <!-- Typography -->
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource N1TextColor}"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource N1TextSecondaryColor}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource N1TextMutedColor}"/>

        <!-- Status -->
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource N1AccentColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource N1DangerColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource N1WarningColor}"/>

        <!-- Shared button style -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#303030"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CS2: Top-left → bottom-right -->
        <LinearGradientBrush x:Key="Cs2CardGradient"
                     StartPoint="0,0"
                     EndPoint="1,1">
            <GradientStop Color="#292929" Offset="0.0"/>
            <GradientStop Color="#202020" Offset="0.5"/>
            <GradientStop Color="#151515" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- LOADOUT: Top-right → bottom-left -->
        <LinearGradientBrush x:Key="LoadoutCardGradient"
                     StartPoint="1,0"
                     EndPoint="0,1">
            <GradientStop Color="#292929" Offset="0.0"/>
            <GradientStop Color="#202020" Offset="0.5"/>
            <GradientStop Color="#151515" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- BRIDGE: Bottom-left → top-right -->
        <LinearGradientBrush x:Key="BridgeCardGradient"
                     StartPoint="0,1"
                     EndPoint="1,0">
            <GradientStop Color="#292929" Offset="0.0"/>
            <GradientStop Color="#202020" Offset="0.5"/>
            <GradientStop Color="#151515" Offset="1.0"/>
        </LinearGradientBrush>

      </ResourceDictionary>
    </Application.Resources>
</Application>
