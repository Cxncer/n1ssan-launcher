<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>n1ssan_launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\icons\n1ssan-black.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="connection-white.png" />
    <None Remove="cs2-white.png" />
    <None Remove="dll-white.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\icons\n1ssan-icon-white.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\icons\cs2-white.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\icons\connection-white.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\icons\dll-white.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="connection-white.png" />
    <Resource Include="cs2-white.png" />
    <Resource Include="dll-white.png" />
    <Resource Include="assets\icons\n1ssan-black.ico" />
  </ItemGroup>
</Project>
